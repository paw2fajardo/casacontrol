# =============================================================================
# CasaControl - Environment Configuration Template
# =============================================================================
# Copy this file to .env before starting the container or define these
# variables in Portainer's Stack Environment Variables configuration section.
# =============================================================================

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
# Port the CasaControl dashboard server listens on inside and exposed from the container
PORT=3000

# Host network interface to bind (0.0.0.0 to accept connections from LAN tablets)
HOST=0.0.0.0

# Node environment mode (production for deployed containers)
NODE_ENV=production

# -----------------------------------------------------------------------------
# CartSync Integration (Portainer Stack ID 87)
# -----------------------------------------------------------------------------
# Base URL for the CartSync grocery list service.
# CartSync runs on host 192.168.10.200 with container port 3001 published to host port 9090.
# If connecting directly via container network, use http://cartsync:3001
CARTSYNC_BASE_URL=http://192.168.10.200:9090

# Optional Bearer token for CartSync API authentication.
# Required only if HOUSEHOLD_SECRET or SYNC_AUTH_TOKEN is configured in the CartSync stack.
# Leave blank if authentication is disabled.
CARTSYNC_AUTH_TOKEN=

# -----------------------------------------------------------------------------
# Home Assistant Integration (Portainer Stack ID 60)
# -----------------------------------------------------------------------------
# Base URL for the Home Assistant instance on host 192.168.10.200 (default port 8123).
# If connecting directly via container network, use http://homeassistant:8123
HOMEASSISTANT_BASE_URL=http://192.168.10.200:8123

# Long-Lived Access Token generated in Home Assistant (Profile -> Security -> Long-Lived Access Tokens).
# This token remains strictly server-side and is never exposed to browser clients.
HOMEASSISTANT_AUTH_TOKEN=your_ha_long_lived_access_token_here

# -----------------------------------------------------------------------------
# Google Calendar & Tasks Integration (Single Household Account)
# -----------------------------------------------------------------------------
# Google Cloud Console OAuth 2.0 Web Client ID
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Google Cloud Console OAuth 2.0 Web Client Secret
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Long-lived OAuth 2.0 Refresh Token obtained for the household Google account.
# Configured with read-only scopes:
#   - https://www.googleapis.com/auth/calendar.readonly
#   - https://www.googleapis.com/auth/tasks.readonly
GOOGLE_REFRESH_TOKEN=your_google_refresh_token_here
